<%- include('partials/header.ejs') %>

<h4>Learner dashboard</h4>

<div class="row">
  <div class="col-md-6">
    <div class="card p-3 mb-3">
      <h6>Your courses</h6>
      <% if (!courses || courses.length === 0) { %>
        <div class="alert alert-info">You are not enrolled in any course yet.</div>
      <% } else { %>
        <ul class="list-group">
          <% courses.forEach(c => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <strong><%= c.title %></strong><br/>
                <% if (c.description) { %><small class="text-muted"><%= c.description %></small><% } %>
              </div>
              <div>
                <% if (c.link) { %>
                  <a class="btn btn-sm btn-outline-primary" href="<%= c.link %>" target="_blank">Open</a>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="card p-3">
      <h6>Assignments</h6>
      <% if (!assignments || assignments.length === 0) { %>
        <div class="alert alert-info">No assignments</div>
      <% } else { %>
        <ul class="list-group">
          <% assignments.forEach(a => { %>
            <li class="list-group-item">
              <div class="d-flex justify-content-between">
                <div>
                  <strong><%= a.title %></strong><br/>
                  <small class="text-muted"><%= a.instructor_name %></small>
                </div>
                <div>
                  <% const submitted = (submissions || []).find(s => Number(s.assignment_id) === Number(a.id)); %>
                  <% if (submitted) { %>
                    <span class="badge bg-success">Submitted</span>
                    <% if (submitted.graded) { %>
                      <div class="small">Grade: <strong><%= submitted.grade %></strong></div>
                    <% } %>
                  <% } else { %>
                    <button class="btn btn-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#submit-<%= a.id %>">Submit</button>
                  <% } %>
                </div>
              </div>

              <div class="collapse mt-2" id="submit-<%= a.id %>">
                <form action="/learner/submit-assignment" method="POST" enctype="multipart/form-data">
                  <input type="hidden" name="assignment_id" value="<%= a.id %>" />
                  <div class="mb-2">
                    <label class="form-label small">Optional file</label>
                    <input type="file" name="file" class="form-control" />
                  </div>
                  <div class="mb-2">
                    <input name="external_link" class="form-control" placeholder="Optional external link" />
                  </div>
                  <div class="d-grid">
                    <button class="btn btn-success btn-sm">Submit assignment</button>
                  </div>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card p-3 mb-3">
      <h6>Materials</h6>
      <% if (!materials || materials.length === 0) { %>
        <div class="alert alert-info">No materials yet</div>
      <% } else { %>
        <ul class="list-group">
          <% materials.forEach(m => { %>
            <li class="list-group-item">
              <strong><%= m.title %></strong><br/>
              <small class="text-muted"><%= m.course_title %></small><br/>
              <% if (m.file_link) { %><a href="<%= m.file_link %>" download>Download</a><% } %>
              <% if (m.external_link) { %> <a href="<%= m.external_link %>" target="_blank">Open link</a><% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="card p-3">
      <h6>Meetings</h6>
      <% if (!meetings || meetings.length === 0) { %>
        <div class="alert alert-info">No meetings</div>
      <% } else { %>
        <% meetings.forEach(m => { %>
          <div class="mb-2">
            <strong><%= m.title || 'Meeting' %></strong><br/>
            <a class="btn btn-sm btn-outline-primary" href="<%= m.link %>" target="_blank">Join</a>
            <div class="small text-muted"><%= m.start_time %></div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div class="card p-3 mt-3">
      <h6>Request certificate</h6>
      <form action="/learner/request-certificate" method="POST">
        <div class="mb-2">
          <select name="course_id" class="form-select" required>
            <option value="">Select course</option>
            <% (courses || []).forEach(c => { %>
              <option value="<%= c.id %>"><%= c.title %></option>
            <% }) %>
          </select>
        </div>
        <div class="d-grid">
          <button class="btn btn-outline-primary btn-sm">Request certificate</button>
        </div>
      </form>
      <small class="text-muted">You can only request certificate after reaching 100% progress.</small>
    </div>
  </div>
</div>

<%- include('partials/footer.ejs') %>