<%- include('partials/header.ejs') %>

<h4 class="mb-4">Learner dashboard</h4>

<div class="row g-4">
  <div class="col-lg-6">
    <!-- Courses + Progress -->
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <h6 class="card-title">Your courses</h6>
        <% if (!courses || courses.length === 0) { %>
          <div class="alert alert-info mb-0">You are not enrolled in any course yet.</div>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% courses.forEach(c => { %>
              <% 
                // find progress entry for this learner & course
                const prog = (progress || []).find(p => Number(p.course_id) === Number(c.id));
                const percent = prog ? Number(prog.progress_percent || 0) : 0;
              %>
              <li class="list-group-item py-3 d-flex flex-column flex-md-row justify-content-between align-items-start">
                <div class="me-3 w-100">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <strong class="d-block text-truncate"><%= c.title %></strong>
                      <% if (c.description) { %>
                        <small class="text-muted d-block"><%= c.description %></small>
                      <% } %>
                    </div>

                    <div class="text-end ms-3" style="min-width:140px;">
                      <% if (percent > 0) { %>
                        <div class="small text-muted mb-1">Progress</div>
                        <div class="d-flex align-items-center gap-2">
                          <div style="min-width:48px;"><strong><%= percent %>%</strong></div>
                          <div class="progress w-100" style="height:8px;">
                            <div class="progress-bar" role="progressbar" style="width: <%= percent %>%;" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100"></div>
                          </div>
                        </div>
                      <% } else { %>
                        <div class="small text-muted">No progress yet</div>
                      <% } %>

                      <% if (c.link) { %>
                        <!-- Responsive button: full width on small, auto on md+ -->
                        <div class="mt-2">
                          <a class="btn btn-sm btn-outline-primary w-100 w-md-auto" href="<%= c.link %>" target="_blank" rel="noopener noreferrer">Open</a>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>

    <!-- Assignments -->
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="card-title">Assignments</h6>

        <% if (!assignments || assignments.length === 0) { %>
          <div class="alert alert-info mb-0">No assignments</div>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% assignments.forEach(a => { %>
              <% 
                const submitted = (submissions || []).find(s => Number(s.assignment_id) === Number(a.id));
                const collapseId = `submit-${a.id}`;
              %>

              <li class="list-group-item py-3">
                <div class="d-flex align-items-start justify-content-between gap-3 flex-column flex-md-row">
                  <div class="me-2 flex-grow-1">
                    <strong><%= a.title %></strong>
                    <% if (a.course_title) { %>
                      <div class="small text-muted"><%= a.course_title %></div>
                    <% } %>
                    <% if (a.description) { %>
                      <div class="mt-1 small text-muted"><%= a.description %></div>
                    <% } %>
                    <% if (a.due_date) { %>
                      <div class="mt-1 small text-danger">Due: <%= a.due_date %></div>
                    <% } %>
                  </div>

                  <div class="text-end ms-0 ms-md-3" style="min-width:160px;">
                    <!-- Buttons become stacked on small screens and inline on md+ -->
                    <div class="d-grid gap-2 d-md-flex justify-content-end align-items-center">
                      <% if (a.file_link) { %>
                        <a class="btn btn-sm btn-outline-secondary w-100 w-md-auto" href="<%= a.file_link %>" download rel="noopener noreferrer">
                          <i class="bi bi-download"></i> Download
                        </a>
                      <% } %>

                      <% if (a.external_link) { %>
                        <a class="btn btn-sm btn-outline-primary w-100 w-md-auto" href="<%= a.external_link %>" target="_blank" rel="noopener noreferrer">
                          <i class="bi bi-box-arrow-up-right"></i> Open
                        </a>
                      <% } %>

                      <% if (submitted) { %>
                        <button class="btn btn-sm btn-success w-100 w-md-auto" disabled><i class="bi bi-check-lg"></i> Submitted</button>
                      <% } else { %>
                        <!-- Submit button always visible for beginner-friendly UX -->
                        <button class="btn btn-sm btn-primary w-100 w-md-auto" type="button" data-bs-toggle="collapse" data-bs-target="#<%= collapseId %>" aria-expanded="false" aria-controls="<%= collapseId %>">
                          <i class="bi bi-upload"></i> Submit
                        </button>
                      <% } %>
                    </div>

                    <div class="small text-muted mt-1 text-start text-md-end">
                      <%= a.instructor_name ? 'Instructor: ' + a.instructor_name : '' %>
                    </div>
                  </div>
                </div>

                <% if (!submitted) { %>
                  <div class="collapse mt-3" id="<%= collapseId %>">
                    <form action="/learner/submit-assignment" method="POST" enctype="multipart/form-data" class="row g-2 align-items-end">
                      <input type="hidden" name="assignment_id" value="<%= a.id %>" />
                      <div class="col-12 col-md-6">
                        <label class="form-label visually-hidden" for="file-<%= a.id %>">File</label>
                        <input id="file-<%= a.id %>" type="file" name="file" class="form-control form-control-sm" />
                      </div>
                      <div class="col-12 col-md-4">
                        <label class="form-label visually-hidden" for="link-<%= a.id %>">External link</label>
                        <input id="link-<%= a.id %>" name="external_link" class="form-control form-control-sm" placeholder="Optional external link" />
                      </div>
                      <div class="col-12 col-md-2">
                        <div class="d-grid">
                          <button class="btn btn-success btn-sm w-100" type="submit">Send</button>
                        </div>
                      </div>
                    </form>
                  </div>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <!-- Materials -->
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <h6 class="card-title">Materials</h6>
        <% if (!materials || materials.length === 0) { %>
          <div class="alert alert-info mb-0">No materials yet</div>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% materials.forEach(m => { %>
              <li class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-start">
                <div>
                  <strong><%= m.title %></strong><br/>
                  <small class="text-muted"><%= m.course_title %></small>
                </div>
                <div class="mt-2 mt-md-0">
                  <div class="d-grid gap-2 d-md-flex align-items-center justify-content-end">
                    <% if (m.file_link) { %>
                      <a class="btn btn-sm btn-outline-secondary me-0 me-md-2 w-100 w-md-auto" href="<%= m.file_link %>" download rel="noopener noreferrer">Download</a>
                    <% } %>
                    <% if (m.external_link) { %>
                      <a class="btn btn-sm btn-outline-primary w-100 w-md-auto" href="<%= m.external_link %>" target="_blank" rel="noopener noreferrer">Open</a>
                    <% } %>
                  </div>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>

    <!-- Meetings -->
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <h6 class="card-title">Meetings</h6>
        <% if (!meetings || meetings.length === 0) { %>
          <div class="alert alert-info mb-0">No meetings</div>
        <% } else { %>
          <% meetings.forEach(m => { %>
            <div class="mb-3 d-flex flex-column flex-md-row justify-content-between align-items-start">
              <div>
                <strong class="d-block"><%= m.title || 'Meeting' %></strong>
                <div class="small text-muted"><%= m.start_time %></div>
              </div>
              <div class="mt-2 mt-md-0">
                <a class="btn btn-sm btn-outline-primary w-100 w-md-auto" href="<%= m.link %>" target="_blank" rel="noopener noreferrer">Join</a>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- Request certificate & summary progress -->
    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="card-title">Request certificate</h6>
        <form action="/learner/request-certificate" method="POST" class="mb-3">
          <div class="mb-2">
            <select name="course_id" class="form-select" required>
              <option value="">Select course</option>
              <% (courses || []).forEach(c => { %>
                <option value="<%= c.id %>"><%= c.title %></option>
              <% }) %>
            </select>
          </div>
          <div class="d-grid">
            <!-- full width on small screens -->
            <button class="btn btn-outline-primary btn-sm w-100" type="submit">Request certificate</button>
          </div>
        </form>
        <small class="text-muted d-block">You can only request certificate after reaching 100% progress.</small>

        <% /* Optionally show a small aggregate / reminder */ %>
        <% const anyComplete = (progress || []).some(p => Number(p.progress_percent) >= 100); %>
        <div class="mt-3">
          <% if (anyComplete) { %>
            <div class="alert alert-success mb-0">You have at least one course at 100% — you may request a certificate.</div>
          <% } else { %>
            <div class="small text-muted mb-0">Keep completing course activities to reach 100%.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer.ejs') %>