<%- include('partials/header.ejs'); -%>

<div class="container py-4">
  <h1 class="h4 mb-3"><%= listTitle %></h1>

  <div class="list-group">
    <div class="row">
      <% (listItems || []).map(item => { %>
      <div class="col-12 col-md-3 -lg-3 me-2">
        <div class="card mb-3" style="width: 18rem">
          <div class="card-body">
            <h5 class="card-title"><%= item.title %></h5>
            <h6 class="card-subtitle mb-2 text-muted">Subtitle here</h6>
            <p class="card-text">Some quick example text.</p>
            <a href="#" class="card-link">Card link</a>
          </div>
          <!-- Mobile-first: stack buttons vertically, switch to horizontal on sm+ -->
          <div class="d-flex flex-column flex-sm-row gap-2 p-3 pt-0">
            <!-- Edit toggle (Bootstrap collapse) -->
            <button
              class="btn btn-sm btn-outline-secondary w-100 w-sm-auto"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#edit-<%= item.id %>"
            >
              Edit
            </button>
            <!-- Delete (simple POST form) -->
            <form action="/delete" method="post" class="m-0 w-100 w-sm-auto">
              <input type="hidden" name="deleteItemId" value="<%= item.id %>" />
              <button
                type="submit"
                class="btn btn-sm btn-outline-danger w-100 w-sm-auto"
              >
                Delete
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Collapsible edit form -->
      <div class="collapse mt-2" id="edit-<%= item.id %>">
        <form action="/edit" method="post" class="d-flex gap-2">
          <input type="hidden" name="updatedItemId" value="<%= item.id %>" />
          <input
            type="text"
            name="updatedItemTitle"
            class="form-control form-control-sm"
            value="<%= item.title %>"
            required
          />
          <button type="submit" class="btn btn-sm btn-primary">Save</button>
        </form>
      </div>

      <% }) %>

      <!-- Add new item -->
      <form
        class="list-group-item d-flex gap-2 mt-3"
        action="/add"
        method="post"
      >
        <input
          type="text"
          name="newItem"
          class="form-control form-control-sm"
          placeholder="New item"
          required
        />
        <button
          class="btn btn-sm btn-success"
          type="submit"
          name="list"
          value="<%= listTitle %>"
        >
          Add
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer.ejs'); -%>
