<%- include('partials/header.ejs') %>

<h4>Admin dashboard</h4>
<div class="row">
  <div class="col-md-4">
    <div class="card mb-3 p-3">
      <h6>Create course</h6>
      <form action="/admin/courses" method="POST">
        <div class="mb-2">
          <input name="title" class="form-control" placeholder="Title" required />
        </div>
        <div class="mb-2">
          <textarea name="description" class="form-control" rows="2" placeholder="Description"></textarea>
        </div>
        <div class="mb-2">
          <input name="link" class="form-control" placeholder="Optional link" />
        </div>
        <button class="btn btn-primary btn-sm">Create</button>
      </form>
    </div>

    <div class="card mb-3 p-3">
      <h6>Enroll learner to course</h6>
      <form action="/admin/enroll" method="POST">
        <div class="mb-2">
          <select name="learner_id" class="form-select" required>
            <option value="">Select learner</option>
            <% (learners || []).forEach(l => { %>
              <option value="<%= l.id %>"><%= l.username %> — <%= l.email %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-2">
          <select name="course_id" class="form-select" required>
            <option value="">Select course</option>
            <% (courses || []).forEach(c => { %>
              <option value="<%= c.id %>"><%= c.title %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn btn-outline-primary btn-sm">Enroll</button>
      </form>
    </div>

    <div class="card mb-3 p-3">
      <h6>Assign instructor</h6>
      <form action="/admin/assign-instructor-course" method="POST">
        <div class="mb-2">
          <select name="instructor_id" class="form-select" required>
            <option value="">Select instructor</option>
            <% (instructors || []).forEach(i => { %>
              <option value="<%= i.id %>"><%= i.username %> — <%= i.email %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-2">
          <select name="course_id" class="form-select" required>
            <option value="">Select course</option>
            <% (courses || []).forEach(c => { %>
              <option value="<%= c.id %>"><%= c.title %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn btn-outline-primary btn-sm">Assign to course</button>
      </form>
    </div>

    <div class="card mb-3 p-3">
      <h6>Assign instructor to learner</h6>
      <form action="/admin/assign-instructor-learner" method="POST">
        <div class="mb-2">
          <select name="instructor_id" class="form-select" required>
            <option value="">Select instructor</option>
            <% (instructors || []).forEach(i => { %>
              <option value="<%= i.id %>"><%= i.username %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-2">
          <select name="learner_id" class="form-select" required>
            <option value="">Select learner</option>
            <% (learners || []).forEach(l => { %>
              <option value="<%= l.id %>"><%= l.username %></option>
            <% }) %>
          </select>
        </div>
        <button class="btn btn-outline-primary btn-sm">Assign</button>
      </form>
    </div>
  </div>

  <div class="col-md-8">
    <div class="card p-3 mb-3">
      <h6>Recent attendance</h6>
      <% if (!attendance || attendance.length === 0) { %>
        <div class="alert alert-info">No attendance recorded yet.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm">
            <thead>
              <tr><th>Date</th><th>Learner</th><th>Course</th><th>Status</th></tr>
            </thead>
            <tbody>
              <% attendance.forEach(a => { %>
                <tr>
                  <td><%= a.date %></td>
                  <td><%= a.learner_name %></td>
                  <td><%= a.course_title %></td>
                  <td><%= a.status %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="card p-3">
      <h6>Certificate requests</h6>
      <% if (!certificateRequests || certificateRequests.length === 0) { %>
        <div class="alert alert-info">No requests</div>
      <% } else { %>
        <table class="table table-sm">
          <thead><tr><th>When</th><th>Learner</th><th>Course</th><th>Status</th><th>Action</th></tr></thead>
          <tbody>
            <% certificateRequests.forEach(r => { %>
              <tr>
                <td><%= r.requested_at %></td>
                <td><%= r.learner_name %></td>
                <td><%= r.course_title %></td>
                <td><%= r.status %></td>
                <td>
                  <form action="/admin/certificate-update" method="POST" class="d-flex gap-2">
                    <input type="hidden" name="request_id" value="<%= r.id %>" />
                    <select name="status" class="form-select form-select-sm" style="width:140px;">
                      <option value="requested" <%= r.status === 'requested' ? 'selected' : '' %>>Requested</option>
                      <option value="issued" <%= r.status === 'issued' ? 'selected' : '' %>>Issued</option>
                    </select>
                    <button class="btn btn-sm btn-outline-primary">Update</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer.ejs') %>