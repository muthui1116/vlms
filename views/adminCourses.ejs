<%- include('partials/header.ejs') %>

<div class="container my-5">
  <div class="row mb-3 align-items-center">
    <div class="col">
      <h1 class="h4">Manage Courses</h1>
      <p class="text-muted mb-0">Create courses and assign learners / instructors.</p>
    </div>
    <div class="col-auto">
      <a class="btn btn-outline-secondary" href="/admin-dashboard">Back to Admin Dashboard</a>
    </div>
  </div>

  <div class="row gx-4 gy-4">
    <div class="col-lg-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title">Create new course</h5>
          <form action="/admin/courses" method="POST">
            <div class="mb-2">
              <label class="form-label small">Title</label>
              <input name="title" class="form-control" required />
            </div>
            <div class="mb-2">
              <label class="form-label small">Description</label>
              <textarea name="description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-2">
              <label class="form-label small">Link</label>
              <input name="link" class="form-control" placeholder="https://..." />
            </div>
            <div class="d-grid mt-2">
              <button class="btn btn-primary">Create course</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card shadow-sm mt-3">
        <div class="card-body">
          <h6 class="card-title">Assign learner to instructor</h6>
          <form action="/admin/assign-learner-instructor" method="POST">
            <div class="mb-2">
              <label class="form-label small">Learner</label>
              <select name="learner_id" class="form-select" required>
                <option value="">Select learner</option>
                <% (learners || []).forEach(l => { %>
                  <option value="<%= l.id %>"><%= l.username %> — <%= l.email %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label small">Instructor</label>
              <select name="instructor_id" class="form-select" required>
                <option value="">Select instructor</option>
                <% (instructors || []).forEach(i => { %>
                  <option value="<%= i.id %>"><%= i.username %> — <%= i.email %></option>
                <% }) %>
              </select>
            </div>
            <div class="d-grid">
              <button class="btn btn-outline-primary btn-sm">Assign</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title">Existing courses</h5>

          <% if ((courses || []).length === 0) { %>
            <div class="alert alert-info">No courses yet.</div>
          <% } else { %>
            <div class="list-group">
              <% (courses || []).forEach(course => { %>
                <div class="list-group-item">
                  <div class="d-flex w-100 justify-content-between align-items-start">
                    <div>
                      <h6 class="mb-1"><%= course.title %></h6>
                      <% if (course.description) { %>
                        <p class="mb-1 text-muted small"><%= course.description %></p>
                      <% } %>
                      <% if (course.link) { %>
                        <a href="<%= course.link %>" target="_blank" rel="noopener" class="small">Open link</a>
                      <% } %>
                    </div>
                    <div class="text-end">
                      <small class="text-muted">#<%= course.id %></small>
                    </div>
                  </div>

                  <div class="mt-3 d-flex gap-2">
                    <form action="/admin/courses/<%= course.id %>/enroll" method="POST" class="d-flex gap-2">
                      <select name="learner_id" class="form-select form-select-sm" style="width:200px;">
                        <option value="">Enroll learner</option>
                        <% (learners || []).forEach(l => { %>
                          <option value="<%= l.id %>"><%= l.username %> — <%= l.email %></option>
                        <% }) %>
                      </select>
                      <button class="btn btn-sm btn-outline-success">Enroll</button>
                    </form>

                    <form action="/admin/courses/<%= course.id %>/assign-instructor" method="POST" class="d-flex gap-2">
                      <select name="instructor_id" class="form-select form-select-sm" style="width:200px;">
                        <option value="">Assign instructor</option>
                        <% (instructors || []).forEach(i => { %>
                          <option value="<%= i.id %>"><%= i.username %> — <%= i.email %></option>
                        <% }) %>
                      </select>
                      <button class="btn btn-sm btn-outline-primary">Assign</button>
                    </form>

                    <a class="btn btn-sm btn-outline-secondary" href="/admin/courses">Refresh</a>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer.ejs') %>