<footer class="w-100">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12 text-center small text-muted py-3">
        ProwessityVLMS © <span id="footer-year"><%= new Date().getFullYear() %></span> — Engineered by Francil — where passion meets innovation
      </div>
    </div>
  </div>
</footer>

<script>
  // Fallback for environments that do not render server-side JS (keeps year up-to-date)
  (function () {
    const yEl = document.getElementById('footer-year');
    if (yEl && (!yEl.textContent || yEl.textContent.trim() === '')) {
      yEl.textContent = new Date().getFullYear();
    }
  })();
</script>

